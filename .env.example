# LLM Provider: "anthropic" or "openai"
LLM_PROVIDER=anthropic

# API Keys
ANTHROPIC_API_KEY=sk-ant-xxx
OPENAI_API_KEY=sk-xxx

# Model (leave empty for default: claude-sonnet-4-5 / gpt-4o-mini)
MODEL_NAME=

# LLM max tokens per response
LLM_MAX_TOKENS=4096

# Memory
DB_PATH=memory/agent.db
MEMORY_DIR=memory
WORKING_MAX_PER_CONV=50

# Agent
MAX_ITERATIONS=10

# RAG (Layer 2)
RAG_ENABLED=false
RETRIEVER_PROVIDER=noop

# Verifier
VERIFICATION_ENABLED=true
VERIFIER_SOFT_FALLBACK=true
VERIFIER_SAMPLING_RATE=0.1

# API Server
API_HOST=0.0.0.0
API_PORT=8000

# General
LOG_LEVEL=INFO
