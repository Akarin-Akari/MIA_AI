# LLM Provider: "anthropic" or "openai"
LLM_PROVIDER=anthropic

# API Keys
ANTHROPIC_API_KEY=sk-ant-xxx
OPENAI_API_KEY=sk-xxx

# Model (leave empty for default: claude-sonnet-4-5 / gpt-4o-mini)
MODEL_NAME=

# Memory
DB_PATH=memory/agent.db
MEMORY_DIR=memory

# Agent
MAX_ITERATIONS=10

# RAG (Layer 2)
RAG_ENABLED=false
RETRIEVER_PROVIDER=noop

# Verifier
VERIFICATION_ENABLED=true
VERIFIER_SOFT_FALLBACK=true
VERIFIER_SAMPLING_RATE=0.1

# General
LOG_LEVEL=INFO
